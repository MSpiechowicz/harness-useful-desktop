---
source: business/tests/views/opencode_views.rs
expression: "exported(config(&env, None), &home, &project)"
---
{
  "harness": "opencode",
  "sections": [
    {
      "id": "user:~/.config/opencode/opencode.jsonc",
      "title": "Settings",
      "description": "Global OpenCode settings: models, providers, agents, permissions and MCP servers.",
