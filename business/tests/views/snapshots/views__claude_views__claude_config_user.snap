  "notices": [
    {
      "level": "info",
      "message": "Claude Code also loads these memory files, whose text is not shown here: ~/.claude/CLAUDE.md (user)."
    },
    {
      "level": "info",
      "message": "Harness Skills options set in Claude Code's /plugin configure flow apply when no saved file exists. They are not visible here."
    },
    {
      "level": "info",
      "message": "The login (.credentials.json), prompt history, caches and backups are never read."
    },
    {
      "level": "info",
      "message": "From .claude.json only MCP servers and this project's tool and trust settings are shown."
