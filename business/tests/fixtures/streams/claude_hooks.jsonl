// Hooks in a Claude Code chat (src-tauri hooks tests, frames of tools.jsonl, interrupt.jsonl and basic.jsonl,
// Edit, MultiEdit and NotebookEdit calls shaped after the recorded Write): the first prompt carries the
// sessionStart and promptSubmit context; its run (tools.jsonl) reads a file, writes hello.txt and has Bash
// declined, and the toolEnd hooks' output goes out as one follow-up once the run is over. The follow-up's
// own run (an Edit) earns none. The next user run edits three files and is interrupted: no follow-up. The
// last prompt is the next message the CLI reads.
{"include": "claude_init.jsonl"}
{"expect": "user", "as": "prompt", "match": {"/message/content": "<harness-hook-context>\n<hook name=\"Project notes\">Read NOTES.md first.</hook>\n<hook name=\"Style\">Be brief.</hook>\n</harness-hook-context>\n\nFix the parser"}}
{"replay": "../claude/stream/tools.jsonl", "from": 7, "to": 115, "except": ["control_request", "control_response"], "replace": {"8eaa941b-e611-4895-bac2-95b7d3e75f4f": "$prompt"}}
// The follow-up: the toolEnd outputs in hook order (the Tool log hook prints nothing).
{"expect": "user", "as": "followup", "match": {"/message/content": "<harness-hook-followup name=\"Changed files\">tool Write touched hello.txt</harness-hook-followup>\n\n<harness-hook-followup name=\"Shell\">ran Bash</harness-hook-followup>"}}
{"emit": {"type": "command_lifecycle", "command_uuid": "$followup", "state": "queued", "uuid": "c1a0e501-0000-4000-8000-000000000001", "session_id": "0a433744-8ef1-4d3c-861b-8ff5bc0e302c"}}
