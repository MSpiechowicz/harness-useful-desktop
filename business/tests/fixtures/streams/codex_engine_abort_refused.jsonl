// The user stops a prompt before its turn began and Codex then refuses that turn/start: the stop
// ends with it, so the next prompt (the plain turn of codex_engine_basic.jsonl) is not interrupted,
// and the refused message is not counted.
{"include": "codex_engine_open.jsonl"}
{"expect": "turn/start", "as": "refused", "hold": true}
{"sleep": 300}
{"respond": "refused", "error": "Codex is busy"}
