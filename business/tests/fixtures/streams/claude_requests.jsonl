// Requests the engine answers itself: a hook callback (no app hooks yet: no opinion) and a request
// it does not handle (an error), then a permission prompt it leaves open.
{"include": "claude_init.jsonl"}
{"emit": {"type": "control_request", "request_id": "11111111-1111-4111-8111-111111111111", "request": {"subtype": "hook_callback", "callback_id": "askall", "input": {"hook_event_name": "PreToolUse", "tool_name": "Read"}}}}
{"expect": "control_response", "match": {"/response/request_id": "11111111-1111-4111-8111-111111111111", "/response/subtype": "success", "/response/response": {}}}
{"emit": {"type": "control_request", "request_id": "22222222-2222-4222-8222-222222222222", "request": {"subtype": "mcp_message", "server_name": "x", "message": {}}}}
{"expect": "control_response", "match": {"/response/request_id": "22222222-2222-4222-8222-222222222222", "/response/subtype": "error"}}
{"replay": "../claude/stream/tools.jsonl", "from": 30, "to": 30}
{"emit": {"type": "system", "subtype": "session_title_changed", "title": "Marker", "session_id": "0a433744-8ef1-4d3c-861b-8ff5bc0e302c"}}
