// An OpenCode 2 chat with an approval mode whose configuration OpenCode reloads while it runs without a
// change: once the test renames the session, OpenCode announces `config.updated` and `agent.updated` and
// lists the same agents with the same rules. The chat checks the mode again and goes on. A second title
// marks the end.
{"allow":"GET /api/permission/saved","match":{"query.projectID":"global"},"reply":{"data":[]}}
{"include":"opencode2_startup.jsonl"}
{"sse":{"type":"session.renamed","location":{"directory":"$directory"},"data":{"sessionID":"ses_ea2843d6fffeeHJKZwBKUXqULv","title":"Marker"}}}
{"expect":"PATCH /api/session/ses_ea2843d6fffeeHJKZwBKUXqULv","match":{"title":"Go"}}
{"sse":{"type":"config.updated","location":{"directory":"$directory"},"data":{}}}
{"sse":{"type":"agent.updated","location":{"directory":"$directory"},"data":{}}}
{"sse":{"type":"session.renamed","location":{"directory":"$directory"},"data":{"sessionID":"ses_ea2843d6fffeeHJKZwBKUXqULv","title":"Checked"}}}
{"hang":true}
