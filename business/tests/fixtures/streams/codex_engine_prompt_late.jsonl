// Codex takes a turn only after the chat gave up waiting for its answer: the turn runs, and its
// message counts once more.
{"include": "codex_engine_open.jsonl"}
{"expect": "turn/start", "as": "late", "hold": true}
{"sleep": 600}
{"respond": "late", "reply": {"turn": {"id": "turn-slow", "items": [], "itemsView": "notLoaded", "status": "inProgress", "error": null, "startedAt": null, "completedAt": null, "durationMs": null}}}
{"emit": {"method": "turn/started", "params": {"threadId": "01a164a0-4c41-7613-9735-20de2a8016a8", "turn": {"id": "turn-slow", "items": [], "status": "inProgress", "error": null}}, "emittedAtMs": 1}}
{"emit": {"method": "item/completed", "params": {"item": {"type": "agentMessage", "id": "msg-slow", "text": "Late answer.", "phase": "final_answer"}, "threadId": "01a164a0-4c41-7613-9735-20de2a8016a8", "turnId": "turn-slow"}, "emittedAtMs": 1}}
{"emit": {"method": "turn/completed", "params": {"threadId": "01a164a0-4c41-7613-9735-20de2a8016a8", "turn": {"id": "turn-slow", "items": [], "status": "completed", "error": null}}, "emittedAtMs": 1}}
