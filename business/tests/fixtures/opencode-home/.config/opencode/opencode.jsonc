{
  "$schema": "https://opencode.ai/config.json",
  // Default model for every session.
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  /* Providers: one literal key (never shown), one read from the environment. */
  "provider": {
    "x": {
      "options": {
        "apiKey": "CANARY-7f3a9c",
        "baseURL": "https://llm.example.com/v1",
      },
    },
    "anthropic": {
      "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" },
    },
  },
  "instructions": ["{file:./house-rules.md}", "CONTRIBUTING.md"],
  "permission": { "edit": "ask", "bash": { "*": "ask", "git status": "allow" } },
  "agent": {
    "plan": { "model": "anthropic/claude-opus-4-1" },
    "docs": {
      "description": "Writes and updates documentation.",
      "mode": "subagent",
      "model": "openai/gpt-5",
    },
    "explore": { "disable": true },
  },
  "mode": {
    "focus": { "description": "Legacy mode: primary agent without distractions." },
  },
  "command": {
    "deploy": { "template": "Deploy the branch to staging.", "description": "Deploy the current branch" },
  },
  "plugin": [
    "opencode-wakatime@1.2.0",
    ["@acme/opencode-plugin", { "apiKey": "CANARY-7f3a9c" }],
    "./plugins/hello.ts",
  ],
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github", "--token=CANARY-7f3a9c", "--api-key", "CANARY-7f3a9c"],
      "environment": { "GITHUB_TOKEN": "CANARY-7f3a9c", "GITHUB_HOST": "{env:GITHUB_HOST}" },
      "enabled": true,
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "headers": { "Authorization": "Bearer CANARY-7f3a9c" },
      "oauth": { "clientId": "desktop-client", "clientSecret": "CANARY-7f3a9c", "scope": "read" },
      "timeout": 10000,
    },
    "internal": {
      "type": "remote",
      "url": "https://bot:CANARY-7f3a9c@mcp.example.com/sse?key=CANARY-7f3a9c",
      "enabled": false,
    },
  },
}
