{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. Grants only the app's own IPC commands. No core:* permission is granted: the UI calls nothing but invoke() of app commands, and Channel delivery (__TAURI_CHANNEL__ fetch) is not ACL-gated. No plugin permission is granted: dialog/opener/window-state/log/updater are driven from Rust only, so their JS APIs stay unreachable from the webview.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-drop-listen",
    "allow-attachment-save",
    "allow-prefs-get",
    "allow-prefs-set",
    "allow-harness-list",
    "allow-harness-detect",
    "allow-harness-pick-binary",
    "allow-harness-clear-binary",
    "allow-config-view",
    "allow-extensions-view",
    "allow-commands-catalog",
    "allow-project-pick",
    "allow-project-open",
    "allow-project-close",
    "allow-project-recent",
    "allow-project-forget",
    "allow-reveal-path",
    "allow-open-external",
    "allow-agent-start",
    "allow-agent-send",
    "allow-agent-ui-respond",
    "allow-agent-bash",
    "allow-agent-stop",
    "allow-agent-list",
    "allow-agent-move-project",
    "allow-sessions-list",
    "allow-session-tree",
    "allow-session-messages",
    "allow-session-files-touched",
    "allow-git-status",
    "allow-git-branches",
    "allow-git-diff",
    "allow-review-compose",
    "allow-ecosystem-status",
    "allow-ecosystem-releases",
    "allow-dashboard-availability",
    "allow-dashboard-query",
    "allow-extension-action",
    "allow-update-check",
    "allow-update-install",
    "allow-app-relaunch",
    "allow-launch-sound"
  ]
}
