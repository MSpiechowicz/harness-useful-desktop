    "event": {
      "type": "textDelta",
      "messageId": "msg-2",
      "contentIndex": 1,
      "delta": "Background: [Option in the Rust book](https://doc.rust-lang.org/book/ch06-01-defining-an-enum.html).\n\n"
    }
  },
  {
    "sessionKey": "3f9a1c2e-7b4d-4e8f-9a6b-2c1d0e5f7a8b",
