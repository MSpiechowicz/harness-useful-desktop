      "messageId": "msg-2",
      "contentIndex": 1,
      "delta": "| File | Change |\n| --- | --- |\n| `src/lib.rs` | `parse` returns `Option` |\n| `ui/app.ts` | handles `null` |\n\n"
    }
  },
  {
    "sessionKey": "3f9a1c2e-7b4d-4e8f-9a6b-2c1d0e5f7a8b",
